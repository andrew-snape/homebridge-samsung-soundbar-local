{
  "name": "@snapeos/homebridge-samsung-soundbar-local",
  "displayName": "Samsung Soundbar Local",
  "version": "1.0.2",
  "description": "Local HomeKit control of Samsung D/F-series soundbars via the IP Control JSON-RPC interface. No cloud, no SmartThings.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^20 || ^22 || ^24 || ^26",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "samsung",
    "soundbar",
    "homekit"
  ],
  "files": [
    "dist",
    "config.schema.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.5.0"
  },
  "author": "Andrew Snape",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-snape/homebridge-samsung-soundbar-local.git"
  },
  "bugs": {
    "url": "https://github.com/andrew-snape/homebridge-samsung-soundbar-local/issues"
  },
  "homepage": "https://github.com/andrew-snape/homebridge-samsung-soundbar-local#readme",
  "publishConfig": {
    "access": "public"
  }
}
